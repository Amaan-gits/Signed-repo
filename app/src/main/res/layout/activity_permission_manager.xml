<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@android:color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔐 Permission Manager"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#6200EE"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready to grant permissions"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="0"
        app:trackColor="#E0E0E0"
        app:indicatorColor="#6200EE"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0/25 permissions"
        android:gravity="center"
        android:textSize="14sp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btn_grant_all"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="GRANT ALL PERMISSIONS"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="⚠️ This app requires ALL permissions to function properly\n\n• Storage - Access all files\n• Location - GPS tracking\n• Camera - Photo capture\n• Microphone - Audio recording\n• Contacts - Read contacts\n• SMS - Read messages\n• Calls - Call logs\n• Notifications - All notifications\n• Accessibility - Screen content\n• Usage Stats - App usage\n\n✅ One click = All permissions"
        android:textSize="14sp"
        android:textColor="#666"
        android:lineSpacingExtra="4dp"/>

</LinearLayout>
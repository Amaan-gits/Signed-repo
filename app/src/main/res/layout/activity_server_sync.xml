<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Server Sync Status"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/tv_server_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Server URL: Loading..."
        android:textSize="14sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_device_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Device ID: Loading..."
        android:textSize="14sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Checking connection..."
        android:textSize="18sp"
        android:padding="16dp"
        android:background="#F5F5F5"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_last_sync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Last Sync: Never"
        android:textSize="14sp"
        android:layout_marginTop="16dp"/>

</LinearLayout>